---
import { experience } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id={t('id.experience')}>
  <div class="container">
    <h2 class="section-title"><span>03.</span>{t('experience.title')}</h2>
    <ol>
      {experience.map((job) => (
        <li>
          <span class="period">{job.period[lang]}</span>
          <div>
            <h3>{job.role[lang]} <span>@ {job.company}</span></h3>
            <ul>
              {job.description.map((d) => <li>{d[lang]}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ol > li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  ol > li:first-child {
    padding-top: 0;
  }
  ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  ul li + li {
    margin-top: 0.25rem;
  }
  ul li::marker {
    color: var(--accent);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  h3 span {
    color: var(--accent);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    ol > li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
