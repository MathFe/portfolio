---
import { about, skills, education } from '../data/site';
---

<section id="sobre">
  <div class="container">
    <h2 class="section-title"><span>01.</span>Sobre mim</h2>
    <div class="grid">
      <div>
        <div class="text">
          {about.map((p) => <p>{p}</p>)}
        </div>
        <h3>Formação</h3>
        <ul class="edu">
          {education.map((e) => (
            <li>
              <strong>{e.course}</strong>
              <span>{e.school} · {e.period}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        {skills.map((s) => (
          <div class="group">
            <h3>{s.group}</h3>
            <ul class="skills">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 3rem;
  }
  .text p {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  h3 {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .text + h3 {
    margin-top: 2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .edu li {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0 0.6rem 1rem;
    border-left: 2px solid var(--border);
  }
  .edu strong {
    font-weight: 500;
  }
  .edu span {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .group + .group {
    margin-top: 1.5rem;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skills li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-soft);
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
