---
import { projects } from '../data/site';
---

<section id="projetos">
  <div class="container">
    <h2 class="section-title"><span>02.</span>Projetos</h2>
    <div class="grid">
      {projects.map((p) => (
        <article class:list={['card', { featured: p.featured }]}>
          <div class="top">
            <div>
              {p.featured && <span class="label">Destaque</span>}
              <h3>{p.title}</h3>
              {p.status && <span class="status">{p.status}</span>}
            </div>
            <div class="links">
              {p.repo && (
                <a href={p.repo} target="_blank" rel="noopener" aria-label={`Código de ${p.title}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
                </a>
              )}
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener" aria-label={`Demo de ${p.title}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                </a>
              )}
            </div>
          </div>
          <p>{p.description}</p>
          <ul>
            {p.tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-soft);
    transition: transform 0.2s, border-color 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .featured {
    grid-column: 1 / -1;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .status {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 0.75rem;
    color: var(--muted);
  }
  .links a:hover {
    color: var(--accent);
  }
  p {
    flex: 1;
    margin: 0.75rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
  }
</style>
