---
import { site } from '../data/site';
import { getLang, homePath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const otherLang = lang === 'pt' ? 'en' : 'pt';

const nav = [
  { href: `#${t('id.about')}`, label: t('nav.about') },
  { href: `#${t('id.projects')}`, label: t('nav.projects') },
  { href: `#${t('id.experience')}`, label: t('nav.experience') },
  { href: `#${t('id.contact')}`, label: t('nav.contact') },
];
const initials = site.name
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<header>
  <div class="container inner">
    <a href={homePath(lang)} class="logo" aria-label={t('nav.home')}>{initials}<span>.</span></a>
    <nav aria-label={t('nav.main')}>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a
        class="lang"
        href={homePath(otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        title={t('lang.switch')}
        aria-label={t('lang.switch')}
      >
        {otherLang.toUpperCase()}
      </a>
      <button id="theme-toggle" type="button" aria-label={t('theme.toggle')}>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }
  .logo {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.15rem;
  }
  .logo span {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  ul a:hover {
    color: var(--text);
  }
  .lang {
    display: grid;
    place-items: center;
    height: 2.25rem;
    padding: 0 0.6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .lang:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  nav .lang {
    margin-right: -0.75rem;
  }
  button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .moon {
    display: none;
  }
  :global([data-theme='light']) .sun {
    display: none;
  }
  :global([data-theme='light']) .moon {
    display: block;
  }
  @media (max-width: 640px) {
    ul {
      display: none;
    }
  }
</style>
