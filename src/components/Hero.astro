---
import { site, links } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container">
    {site.available && (
      <p class="status"><span class="dot"></span>{t('hero.available')}</p>
    )}
    <p class="hello">{t('hero.hello')}</p>
    <h1>{site.name}</h1>
    <p class="role">{site.role[lang]} · {site.location[lang]}</p>
    <p class="headline">{site.headline[lang]}</p>
    <p class="intro">{site.intro[lang]}</p>
    <div class="actions">
      <a class="btn btn-primary" href={`#${t('id.projects')}`}>{t('hero.cta.projects')}</a>
      <a class="btn" href={`#${t('id.contact')}`}>{t('hero.cta.contact')}</a>
      {links.resume[lang] && <a class="btn" href={links.resume[lang]} target="_blank">{t('hero.cta.resume')}</a>}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 7rem 0 5rem;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  .hello {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 700;
  }
  .role {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .headline {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 30ch;
  }
  .intro {
    margin: 0 0 2.5rem;
    color: var(--muted);
    max-width: 60ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
</style>
